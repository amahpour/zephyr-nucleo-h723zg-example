/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Virtual PCB topology.
 *
 * The I2C bus leaves the process: transactions are forwarded to a separate
 * board process where the IC models run as their own OS processes.
 *
 * The ADC is internal to the MCU, so it stays in-process. native_sim already
 * provides an adc_emul instance at &adc0; widen it to the 15 channels this
 * application samples and give it the 3.3 V reference the DAC full-scale is
 * matched to.
 *
 * Two DACs by default. Build with one - the same rig as a bench with a single
 * breakout - by adding:   -- -DDTS_EXTRA_CPPFLAGS=-DAPP_DAC_COUNT=1
 * and run it against vpcb/netlists/adc_loopback_one_dac.txt.
 */

#ifndef APP_DAC_COUNT
#define APP_DAC_COUNT 2
#endif

/ {
    vpcb_i2c: i2c-vpcb {
        compatible = "zephyr,i2c-vpcb";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        clock-frequency = <100000>;

#if APP_DAC_COUNT == 1
        /* One DAC7578 at the breakout's factory address serves channels 0-7.
         * Channels 8-14 are still sampled; nothing drives them.
         */
        dac_u1: dacx578@4c {
            compatible = "ti,dacx578";
            reg = <0x4c>;
            #io-channel-cells = <1>;
            resolution = <12>;
            full-scale-mv = <3300>;
            status = "okay";
        };
#else
        /* Two DAC7578s cover the 15 channels the application samples:
         * 0x48 serves 0-7, 0x4c serves 8-14.
         */
        dac_u1: dacx578@48 {
            compatible = "ti,dacx578";
            reg = <0x48>;
            #io-channel-cells = <1>;
            resolution = <12>;
            full-scale-mv = <3300>;
            status = "okay";
        };

        dac_u2: dacx578@4c {
            compatible = "ti,dacx578";
            reg = <0x4c>;
            #io-channel-cells = <1>;
            resolution = <12>;
            full-scale-mv = <3300>;
            status = "okay";
        };
#endif
    };
};

&adc0 {
    nchannels = <15>;
    ref-internal-mv = <3300>;
    status = "okay";
};

mainmenu "ADC Sampler Application"

menu "Target Selection"

config APP_TARGET_SIM
    bool "Simulator target (QEMU with adc-emul)"
    help
      Build for QEMU x86 simulator with ADC emulation.
      Enables injection commands for testing.

config APP_TARGET_HW
    bool "Hardware target (real ADC)"
    help
      Build for real hardware with physical ADC.
      No injection commands are compiled.

config APP_TARGET_VPCB
    bool "Virtual PCB target (native_sim, out-of-process ICs)"
    help
      Build for native_sim against a virtual PCB. The I2C bus leaves the
      process: IC models run as separate OS processes and are reached over
      a Unix socket, so an absent chip NAKs exactly as it would on copper.

endmenu

menu "Virtual PCB"

config I2C_VPCB
    bool "Virtual PCB I2C controller driver"
    depends on I2C
    help
      I2C controller that forwards transactions out of the process to the
      virtual PCB board process.

endmenu

menu "Application Configuration"

config APP_NUM_CH
    int "Number of ADC channels"
    default 4
    range 1 16
    help
      Number of ADC channels to sample.

config APP_SAMPLE_PERIOD_MS
    int "Sampling period in milliseconds"
    default 100
    range 10 10000
    help
      How often to sample all ADC channels.

endmenu

menu "Device Drivers"

config DAC_DACX578
    bool "TI DACx578 8-channel I2C DAC"
    default y
    depends on DT_HAS_TI_DACX578_ENABLED
    depends on DAC && I2C
    help
      Driver for the TI DAC5578/6578/7578 family. Nothing in it is specific
      to the virtual PCB: it drives whichever I2C controller devicetree hands
      it, so the same object code runs against an out-of-process IC model and
      against real silicon.

endmenu

source "Kconfig.zephyr"

